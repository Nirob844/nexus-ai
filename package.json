{
  "name": "nexus-ai",
  "version": "1.0.0",
  "description": "NEXUS AI - Multi-Tenant AI-Powered Business Operations & Customer Support SaaS",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others --names \"API,AI,WEB\" --prefix-colors \"blue.bold,green.bold,magenta.bold\" \"yarn api:dev\" \"yarn ai:dev\" \"yarn web:dev\"",
    "ai:dev": "apps/ai-service/.venv/bin/uvicorn app.main:app --app-dir apps/ai-service --host 0.0.0.0 --port 8000 --reload",
    "ai:start": "apps/ai-service/.venv/bin/uvicorn app.main:app --app-dir apps/ai-service --host 0.0.0.0 --port 8000",
    "api:build": "yarn --cwd apps/api build",
    "api:dev": "yarn --cwd apps/api start:dev",
    "api:start": "yarn --cwd apps/api start:prod",
    "web:dev": "yarn --cwd apps/web dev",
    "web:build": "yarn --cwd apps/web build",
    "web:start": "yarn --cwd apps/web start",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:restart": "docker compose restart",
    "docker:clean": "docker compose down -v",
    "db:wait": "docker compose exec -T postgres pg_isready -U postgres -d nexus_ai",
    "redis:ping": "docker compose exec -T redis redis-cli ping"
  },
  "keywords": [
    "saas",
    "multi-tenant",
    "nestjs",
    "fastapi",
    "rag",
    "ai-agent",
    "pgvector"
  ],
  "author": "NEXUS AI Team",
  "license": "UNLICENSED",
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
